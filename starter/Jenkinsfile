pipeline {
    agent any
    tools {
        maven 'Maven Install'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir('starter/backend') {
                    bat 'mvn -B clean package'
                }
            }
        }
        stage('Test') {
            steps {
                dir('starter/backend') {
                    bat 'mvn -B test'
                }
            }
            post {
                always {
                    junit testResults: 'starter/backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('starter/backend') {
                    bat '''
                        mvn sonar:sonar ^
                          -Dsonar.projectKey=com.sleapy:backend ^
                          -Dsonar.host.url=http://ip-10-14-130-46:9000 ^
                          -Dsonar.login=%SONAR_TOKEN%
                    '''
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'starter/backend/target/*.jar', fingerprint: true
            }
        }
    }
}
