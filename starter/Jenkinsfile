pipeline {
    agent any
    tools {
        maven 'Maven Install'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir('starter/backend') {
                    sh 'mvn -B clean package'
                }
            }
        }
        stage('Test') {
            steps {
                dir('starter/backend') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit testResults: 'starter/backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'starter/backend/target/*.jar', fingerprint: true
            }
        }
    }
}
