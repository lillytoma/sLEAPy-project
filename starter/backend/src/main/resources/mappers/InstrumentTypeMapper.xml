<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sleapy.project.mappers.InstrumentTypeMapper">

    <!-- Result map for InstrumentType -->
    <resultMap id="InstrumentTypeResultMap" type="com.sleapy.project.models.entities.InstrumentType">
        <id column="InstrumentType_ID" property="instrumentType_id"/>
        <result column="InstrumentType" property="name"/>
    </resultMap>

    <!-- Find instrument type by ID -->
    <select id="findById" parameterType="Long" resultMap="InstrumentTypeResultMap">
        SELECT InstrumentType_ID, InstrumentType
        FROM Instrument_Type
        WHERE InstrumentType_ID = #{id}
    </select>

    <!-- Get all instrument types -->
    <select id="findAll" resultMap="InstrumentTypeResultMap">
        SELECT InstrumentType_ID, InstrumentType
        FROM Instrument_Type
        ORDER BY InstrumentType_ID ASC
    </select>

    <!-- Insert new instrument type -->
    <insert id="save" parameterType="com.sleapy.project.models.entities.InstrumentType" useGeneratedKeys="true" keyProperty="instrumentType_id">
        INSERT INTO Instrument_Type (InstrumentType)
        VALUES (#{name})
    </insert>

    <!-- Update instrument type -->
    <update id="update" parameterType="com.sleapy.project.models.entities.InstrumentType">
        UPDATE Instrument_Type
        SET InstrumentType = #{name}
        WHERE InstrumentType_ID = #{instrumentType_id}
    </update>

    <!-- Delete instrument type by ID -->
    <delete id="deleteById" parameterType="Long">
        DELETE FROM Instrument_Type WHERE InstrumentType_ID = #{id}
    </delete>

</mapper>
