FROM python:3.12-slim
WORKDIR /app
COPY deploy/aws/price-requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY starter/backend/etl/price_service.py .
RUN useradd --create-home sleapy && chown sleapy:sleapy /app
USER sleapy
ENV PYTHONUNBUFFERED=1
CMD ["uvicorn", "price_service:app", "--host", "127.0.0.1", "--port", "8000"]
